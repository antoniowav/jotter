#!/usr/bin/env bash
# Remove what ./install put in ~/.local (or $PREFIX). Your notes are not touched.
set -euo pipefail

name=jotter
PREFIX=${PREFIX:-$HOME/.local}

rm -fv "$PREFIX/bin/$name" \
       "$PREFIX/share/applications/$name.desktop" \
       "$PREFIX/share/icons/hicolor/scalable/apps/$name.svg"
command -v update-desktop-database >/dev/null && update-desktop-database -q "$PREFIX/share/applications" || true

echo "Uninstalled. Your notes in ${JOTTER_DIR:-${NOTES_DIR:-$HOME/Notes}} were left alone."
