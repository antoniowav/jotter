#!/usr/bin/env bash
# Build jotter from this checkout and install it into ~/.local (or $PREFIX).
#   ./install                  PREFIX=~/.local
#   PREFIX=/opt/jotter ./install
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"

name=jotter
PREFIX=${PREFIX:-$HOME/.local}

command -v go >/dev/null || { echo "install: Go is needed to build $name (Arch: sudo pacman -S go)" >&2; exit 1; }

version=$(git describe --tags --dirty 2>/dev/null | sed "s/^v//") || true
[[ -n $version ]] || version=$(cat VERSION)

echo "Building $name $version…"
mkdir -p "$PREFIX/bin"
go build -trimpath -ldflags "-s -w -X main.version=$version" -o "$PREFIX/bin/$name.new" .
mv -f "$PREFIX/bin/$name.new" "$PREFIX/bin/$name"

install -Dm644 assets/$name.desktop "$PREFIX/share/applications/$name.desktop"
install -Dm644 assets/$name.svg "$PREFIX/share/icons/hicolor/scalable/apps/$name.svg"
if command -v update-desktop-database >/dev/null; then update-desktop-database -q "$PREFIX/share/applications" || true; fi
if command -v gtk-update-icon-cache >/dev/null; then gtk-update-icon-cache -qtf "$PREFIX/share/icons/hicolor" 2>/dev/null || true; fi

echo "Installed $PREFIX/bin/$name"
case ":$PATH:" in *":$PREFIX/bin:"*) ;; *) echo "Note: $PREFIX/bin is not on your PATH." ;; esac
