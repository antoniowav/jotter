# Maintainer: Antonio Piattelli <hello@antoniopiattelli.com>
pkgname=jotter
pkgver=0.1.1
pkgrel=1
pkgdesc='Tiny terminal notes app: plain markdown files, folders, live preview'
arch=('x86_64' 'aarch64')
url='https://github.com/antoniowav/jotter'
license=('MIT')
depends=('glibc' 'hicolor-icon-theme')
makedepends=('go')
optdepends=('wl-clipboard: copy and cut on Wayland'
            'xclip: copy and cut on X11')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('bc398abc007e5595ac4204a51dd8c1d169811e0fc48f6227c6ac2c412f8ffefb')

prepare() {
  cd "$pkgname-$pkgver"
  export GOPATH="$srcdir/gopath"
  go mod download -modcacherw
}

build() {
  cd "$pkgname-$pkgver"
  export GOPATH="$srcdir/gopath"
  export CGO_CPPFLAGS="$CPPFLAGS" CGO_CFLAGS="$CFLAGS" CGO_CXXFLAGS="$CXXFLAGS" CGO_LDFLAGS="$LDFLAGS"
  export GOFLAGS='-buildmode=pie -trimpath -mod=readonly -modcacherw'
  go build -ldflags "-linkmode=external -X main.version=$pkgver" -o "$pkgname" .
}

check() {
  cd "$pkgname-$pkgver"
  export GOPATH="$srcdir/gopath" GOFLAGS='-mod=readonly -modcacherw'
  go test ./...
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "assets/$pkgname.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm644 "assets/$pkgname.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$pkgname.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
